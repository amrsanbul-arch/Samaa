# Supabase → Project Settings → API. The anon key is public by design; never put
# the service_role key here.
#
# Next.js only inlines NEXT_PUBLIC_* into the browser bundle. The VITE_* names are
# still read (on the server) because the deployment notes use them, so either pair
# works. Leave both empty to run the app without auth: the login page then shows
# "خدمة تسجيل الدخول لم يتم إعدادها بعد." and disables the form instead of crashing.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Set to false to hide the "Log in with Apple" button until the provider is set up.
NEXT_PUBLIC_ENABLE_APPLE_LOGIN=true
VITE_ENABLE_APPLE_LOGIN=true
